# Server
PORT=3000

# Official Instagram oEmbed (recommended)
# Create a Meta app and provide an App Access Token with oEmbed access.
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0

# Optional, limited fallback: reads Open Graph metadata from public pages only.
# This may stop working at any time and may not be suitable for production/app review.
ENABLE_PUBLIC_METADATA_FALLBACK=false

# Public URL of this backend after deployment, used by the WeChat Mini Program.
PUBLIC_BASE_URL=http://localhost:3000
